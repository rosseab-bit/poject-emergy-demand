# Copiá este archivo como .env y completá tus datos. El .env NO se sube a Git.

# URI de conexión de MongoDB Atlas (Connect > Drivers). Dejá el marcador
# <db_password> en el lugar de la clave: se reemplaza por MONGODB_PASS.
URI=mongodb+srv://USUARIO:<db_password>@CLUSTER.mongodb.net/?appName=NOMBRE

# Clave del usuario de la base (Security > Database Access). Letras y números.
MONGODB_PASS=tu_clave

# Opcional: nombre de la base. Por defecto, demanda_electrica.
MONGODB_DB=demanda_electrica
